<main class="page-shell">
  <header class="page-header">
    <div>
      <p class="eyebrow">ПОИСК ВАКАНСИЙ</p>
      <h1>Вакансии</h1>
      <p class="page-intro">Собирай интересные вакансии в одном месте.</p>
    </div>
    <div class="header-actions">
      <%= link_to "Задать вопрос", new_question_path, class: "button button-secondary" %>
      <%= link_to "Добавить вакансию", new_job_path, class: "button button-primary" %>
    </div>
  </header>

  <% if @jobs.any? %>
    <section class="posting-list" aria-label="Список вакансий">
      <% @jobs.each do |job| %>
        <article class="posting-card">
          <div class="posting-card-heading">
            <div>
              <p class="posting-source"><%= job.source %></p>
              <h2><%= link_to job.title, job %></h2>
            </div>
            <% if job.published_at.present? %>
              <time class="posting-date"><%= l(job.published_at.to_date, format: :long) %></time>
            <% end %>
          </div>
          <% if job.company_name.present? %>
            <p class="posting-company"><%= job.company_name %></p>
          <% end %>
          <% if job.description.present? %>
            <p class="posting-description"><%= truncate(job.description, length: 240) %></p>
          <% end %>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="empty-state">
      <h2>Пока вакансий нет</h2>
      <p>Добавь первую вручную — или позже подключи свой парсер.</p>
      <%= link_to "Добавить первую вакансию", new_job_path, class: "button button-primary" %>
    </section>
  <% end %>
</main>
